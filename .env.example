# Copy to .env.local. See docs/hosted-setup.md for where each value comes from.

# Public: safe in the browser. Without these, accounts are simply disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_ and never commit them.
# The secret key lets the server record verified file uploads.
SUPABASE_SECRET_KEY=
# Cloudflare R2 bucket for model files and photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Shared with Vercel Cron so only it can trigger the nightly storage sweep
# (/api/sweep). Any long random string; without it the sweep is disabled.
CRON_SECRET=
# Where "upload limit reached" notices go: a Discord or Slack incoming
# webhook URL. Without it the notice only reaches the server log.
ALERT_WEBHOOK_URL=
# Public: the site's own address, for canonical links, the sitemap, and link
# previews. Leave it unset locally (http://127.0.0.1:3000 is assumed). On
# Vercel it falls back to the deployment's production URL, so set it to the
# custom domain there:
# NEXT_PUBLIC_SITE_URL=https://garageholds.com
# Public: shown to people who hit their upload allowance so they can ask
# for more.
NEXT_PUBLIC_CONTACT_EMAIL=
# Public: the Amazon Associates tracking id (like garageholds-20). Shopping
# links in the guide and in the labs carry it; without it they still
# point at Amazon, untagged.
NEXT_PUBLIC_AMAZON_TAG=
# Public: the tip jar, a Stripe payment link. The footer links to it when set.
NEXT_PUBLIC_TIP_URL=
# Shared with the preview_mesh Python function (api/preview_mesh.py), which
# makes a simplified copy of any model too big for the browser's 3D preview.
# Any long random string, set on both sides by being in this one environment.
# Without it big models publish as before and show the no-preview placeholder.
PREVIEW_SECRET=
# Local development only: `python tools/mesh-preview/serve_api.py` serves the
# function on this address (export PREVIEW_SECRET in that shell too).
# PREVIEW_API_URL=http://127.0.0.1:8790
# Local development only (omit on Vercel): each `tools/<lab>-generator/serve_api.py`
# serves its hosted /api/<lab> handler on one of these addresses and Next
# forwards to it. `scripts/start-sandbox.ps1` starts all four with the app.
# CRIMP_API_URL=http://127.0.0.1:8766
# SLOPER_API_URL=http://127.0.0.1:8771
# JUG_API_URL=http://127.0.0.1:8781
# FOOT_API_URL=http://127.0.0.1:8785
