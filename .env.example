# Copy to .env.local. See docs/hosted-setup.md for where each value comes from.

# Public: safe in the browser. Without these, accounts are simply disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_ and never commit them.
# The secret key lets the server record verified file uploads.
SUPABASE_SECRET_KEY=
# Cloudflare R2 bucket for model files and photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
